# Application
APP_NAME=trading-agent-tp
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database
# DATABASE_URL=sqlite:///./app.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# SECRET_KEY=your-secret-key-change-this-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# # CORS
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=your_openai_key

# MySQL Database
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# File Proxy Configuration
# Frontend URL for file download proxying (used in chat responses)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
FRONTEND_URL=http://localhost:3000

# Optional: Override file proxy URL explicitly
# FILE_PROXY_BASE_URL=http://localhost:3000/api/files/download